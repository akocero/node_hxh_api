# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:4000

# Request body size limit
BODY_LIMIT=10kb

# Rate limiting (global — all /api routes)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200

# Rate limiting (auth — login, register, forgot password)
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT (User auth)
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# JWT (API key / Guest auth)
JWT_API_SECRET=
JWT_API_EXPIRES_IN=30d

# Email — Resend (Production)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=HXH API <no-reply@yourdomain.com>

# Email — Mailtrap (Development only)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_PRESET=
